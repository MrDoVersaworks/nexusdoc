# Database
DATABASE_URL=                    # Neon PostgreSQL connection string (e.g. postgresql://user:pass@host/db?sslmode=require)

# Auth
JWT_ACCESS_SECRET=               # Secret for signing short-lived access tokens (15min). Use a strong random string.
JWT_REFRESH_SECRET=              # Secret for signing long-lived refresh tokens (7d). Use a strong random string.

# Encryption
AES_ENCRYPTION_KEY=              # 64-character hex string (32 bytes) for AES-256-GCM encryption of user API keys. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# File Storage
BLOB_READ_WRITE_TOKEN=           # Vercel Blob storage read/write token from Vercel dashboard

# Server
PORT=4000                        # Express server port
NODE_ENV=development             # development | production
CORS_ORIGIN=http://localhost:3000  # Frontend URL. In production, set to your Vercel deployment domain.
