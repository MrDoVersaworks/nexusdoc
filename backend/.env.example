# ============================================================
# NEXUSDOC SOVEREIGN ENVIRONMENT TEMPLATE
# ============================================================

# SYSTEM
PORT=5001
NODE_ENV=development

# SECURITY
JWT_SECRET=your_sovereign_secret_here
REFRESH_TOKEN_SECRET=your_refresh_secret_here

# DATABASE (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusdoc

# AI (GEMINI)
# Paste your Gemini API Key here for Document Intelligence
GEMINI_API_KEY=your_gemini_api_key_here

# STORAGE (Cloudinary or Vercel Blob)
CLOUDINARY_CLOUD_NAME=your_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# CLIENT
CLIENT_URL=http://localhost:3000
